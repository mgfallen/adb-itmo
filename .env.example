# Шаблон .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=handmade_market
POSTGRES_PORT=5435

# --- MongoDB ---
MONGO_PORT=27017

# --- mongo-express (веб-UI MongoDB, http://localhost:8082) ---
MONGO_EXPRESS_PORT=8082
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# --- Подключения для задач Airflow (если не задать — возьмутся значения ниже) ---
PG_DSN=postgresql://postgres:postgres@db:5432/handmade_market
MONGO_URI=mongodb://mongo:27017
MONGO_DB=handmade_market


# airflow генерирует пароль при первом старте
# docker exec handmade-market-airflow cat /opt/airflow/standalone_admin_password.txt
